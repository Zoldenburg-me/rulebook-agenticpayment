# Agent secrets (agent/signer/, agent/mcp/). Copy to agent/.env (untracked).
# Names only: never commit a value. The agent loads only this file plus the shared root .env,
# never the relayer, Monerium or owner files. Shared values it reads from root:
# NEAR_NETWORK (testnet only), MPC_SIGNER_CONTRACT_ID, MANDATE_CONTRACT_ID.

# The agent's own function-call key on the mandate contract account (request_signature, sweep, revoke_self only)
AGENT_NEAR_PRIVATE_KEY=
# Chain Signatures derivation path for the agent EOA
AGENT_DERIVATION_PATH=
# The derived agent EOA on Base Sepolia (also its Monerium-linked address)
AGENT_EVM_ADDRESS=

# --- NEAR AI Cloud: used by both the agent runtime (its model) and the scam check (injected by agent/mcp) ---
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=
NEAR_AI_MODEL=
