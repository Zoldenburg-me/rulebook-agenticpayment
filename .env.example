# Shared, non-secret values only. Copy to .env (untracked) and fill in testnet/sandbox values.
# Names only: never commit a value (public constants like the chain id excepted).
# Testnet, Base Sepolia and Monerium sandbox only.
#
# Secrets never go in this file. Each role keeps its own in its own folder:
#   agent/.env           agent's NEAR function-call key, NEAR AI key (agent/signer, agent/mcp)
#   ~/.config/nearh/nearai.env  NEAR AI key, read by the agent (agent/mcp) for the scam check; scamcheck/ reads no file
#   relayer/.env         relayer and submitter keys
#   rails/monerium/.env  Monerium sandbox client id and secret (only here)
#   scripts/owner/.env   owner-side values and the payee registry (no private passkey material)
# Each package loads only its own .env (plus this shared, secret-free file), never another role's.

# --- NEAR testnet ---
# Only testnet is accepted
NEAR_NETWORK=testnet
NEAR_RPC_URL=
# The mandate contract account (its full-access key is deleted at deploy)
MANDATE_CONTRACT_ID=
# Chain Signatures MPC signer contract
MPC_SIGNER_CONTRACT_ID=

# --- Base Sepolia ---
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_CHAIN_ID=84532
USDC_ADDRESS=
EURE_ADDRESS=
# The owner's passkey Safe (sweep destination, float top-ups)
SAFE_ADDRESS=

# --- x402 ---
# Facilitator the seller uses; empty means https://x402.org/facilitator
X402_FACILITATOR_URL=
# Demo seller (seller/)
# Port for GET /weather; empty means 4021
SELLER_PORT=
# Required: the seller's Base Sepolia address (0x + 40 hex). It goes on the mandate allowlist.
SELLER_PAY_TO=
# Price in USDC base units (6 decimals); empty means 10000 (0.01 USDC)
SELLER_AMOUNT=
