# Owner Safe scripts (scripts/owner/safe). Names only: never commit a value.
# Base Sepolia only; every script checks eth_chainId = 84532 on all three URLs.

# The mandate contract and the NEAR submitter, as in scripts/owner/near/.env.example
CONTRACT_ID=
SUBMITTER_ACCOUNT_ID=
# Where safe-passkey.json (public: credential id, P-256 point, Safe address) and the O1 owner key live; default ~/.nearh-owner
OWNER_KEY_DIR=
# Optional: BASE_SEPOLIA_RPC_URL (default https://sepolia.base.org), BUNDLER_URL and PAYMASTER_URL
# (default Candide's public Base Sepolia endpoint), PASSKEY_PORT (default 5174), NEAR_RPC
BASE_SEPOLIA_RPC_URL=
BUNDLER_URL=
PAYMASTER_URL=
PASSKEY_PORT=
