{
  "name": "@nearh/agent-mcp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.ts",
    "test": "pnpm run typecheck && node --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "pay-paypal": "node --env-file-if-exists=.env src/pay-paypal.ts",
    "support": "node --env-file-if-exists=.env.support src/support-cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nearh/agent-signer": "workspace:*",
    "@x402/core": "2.30.0",
    "@x402/fetch": "2.30.0",
    "scamcheck": "workspace:*",
    "viem": "2.57.16",
    "zod": "4.6.7",
    "@nearh/dashboard": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./pay-paypal": "./src/pay-paypal.ts",
    "./support": "./src/support.ts",
    "./support-cli": "./src/support-cli.ts"
  }
}
