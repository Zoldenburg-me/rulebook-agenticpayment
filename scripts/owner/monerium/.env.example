# Owner Monerium link (scripts/owner/monerium). Names only: never commit a value.
# Nothing loads a .env file: these are the names to export in your shell, as the README's
# `export` line does, before `pnpm link-agent <agent>`. Only MONERIUM_ENV_FILE's target is read from disk.
# NEAR side: the same variables as scripts/owner/near/.env.example (CONTRACT_ID, SUBMITTER_ACCOUNT_ID,
# OWNER_KEY_DIR, optional NEAR_RPC, MPC_CONTRACT).
CONTRACT_ID=
SUBMITTER_ACCOUNT_ID=
# Path of the Monerium sandbox credentials file, kept outside the repo
# (default ~/.config/nearh/monerium-sandbox.env). That file holds:
#   MONERIUM_ENVIRONMENT=sandbox, MONERIUM_CLIENT_ID, MONERIUM_CLIENT_SECRET,
#   optional MONERIUM_PROFILE_ID (empty = the app's default profile)
MONERIUM_ENV_FILE=
