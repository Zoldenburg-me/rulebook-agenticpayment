# Owner NEAR scripts (scripts/owner/near). Names only: never commit a value.
# Testnet only: every account must end in .testnet.

# The mandate contract account (exists, full-access key in ~/.near-credentials until deploy-contract deletes it)
CONTRACT_ID=
# Any NEAR account with a key in ~/.near-credentials; pays gas for owner calls
SUBMITTER_ACCOUNT_ID=
# Where the software owner key and generated agent keys live (default ~/.nearh-owner), outside the repo
OWNER_KEY_DIR=
# WebAuthn rp_id and origin stored at deploy (defaults localhost, http://localhost:5173)
OWNER_RP_ID=
OWNER_ORIGIN=
# add-agent: the agent's sweep target; USDC/EURe default to the Base Sepolia tokens
SAFE_ADDRESS=
USDC_ADDRESS=
EURE_ADDRESS=
# Optional: NEAR_RPC (default https://rpc.testnet.near.org), MPC_CONTRACT (default v1.signer-prod.testnet)
NEAR_RPC=
MPC_CONTRACT=
