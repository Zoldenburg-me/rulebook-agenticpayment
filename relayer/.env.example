# Relayer secrets (relayer/). Copy to relayer/.env (untracked); the pnpm scripts load it.
# Names only: never commit a value. Never the agent's env.

CONTRACT_ID=
NEAR_RPC=https://rpc.testnet.near.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# The account named by set_relayer: requests sweeps (caller "relayer")
RELAYER_NEAR_ACCOUNT_ID=
RELAYER_NEAR_PRIVATE_KEY=
# Throwaway Base Sepolia EOA that pays for transferWithAuthorization and the raw-transfer sweep's gas.
# Either a key file (0x key on one line, mode 600) or the key itself.
RELAYER_EVM_KEY_FILE=
RELAYER_EVM_PRIVATE_KEY=
# Any NEAR account that submits owner-signed calls and pays their gas (it cannot sign as the owner)
SUBMITTER_NEAR_ACCOUNT_ID=
SUBMITTER_NEAR_PRIVATE_KEY=
# Directory of ids already relayed, one file each (default ~/.config/nearh/relayer-journal)
RELAYER_JOURNAL=
