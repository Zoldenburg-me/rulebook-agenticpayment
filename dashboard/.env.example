# Copy to dashboard/.env (never commit it). Testnet only.
CONTRACT_ID=
NEAR_RPC=https://rpc.testnet.near.org
# DASHBOARD_PORT must match the contract's passkey origin (get_config().owner.origin).
DASHBOARD_PORT=5173
# Defaults to SC1's scamcheck/.held/held.jsonl.
# DASHBOARD_HELD_FILE=
# The NEAR account that submits passkey-signed owner calls (R1 relayer, relayOwnerCall).
SUBMITTER_NEAR_ACCOUNT_ID=
SUBMITTER_NEAR_PRIVATE_KEY=
# RELAYER_JOURNAL=
