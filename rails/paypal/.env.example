# PayPal sandbox credentials (rails/paypal/ only). Default location ~/.config/nearh/paypal-sandbox.env,
# override with PAYPAL_ENV_FILE. Names only: never commit a value. These live only here: never in the agent's env.

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required for `pnpm start`: one bearer token per agent, `agent=token` pairs separated by commas
# (32-256 chars each). The agent sends its own token; PP3_AGENT_TOKENS in the environment wins.
PP3_AGENT_TOKENS=
# PP-W1 webhook receiver: the id PayPal gave the webhook subscription (scripts/register-webhook.ts create).
PAYPAL_WEBHOOK_ID=
# PP-V1 vault routes (/vault/*, /checkout): the owner's bearer token for /vault/* (32-256 chars).
# Unset = the vault routes are off. PP_OWNER_TOKEN in the environment wins.
PP_OWNER_TOKEN=
