# Monerium sandbox credentials (rails/monerium/ only). Copy to rails/monerium/.env (untracked).
# Names only: never commit a value. Sandbox only. These live only here: never in the agent's env.

MONERIUM_ENVIRONMENT=sandbox
MONERIUM_CLIENT_ID=
MONERIUM_CLIENT_SECRET=
# Optional: the counterpart name M1 puts on each order (Monerium requires one; the signed text has none).
M1_COUNTERPART_FIRST_NAME=
M1_COUNTERPART_LAST_NAME=
# Required for `pnpm start`: one bearer token per agent, `agent=token` pairs separated by commas
# (32-256 chars each). A2 sends its own agent's token; M1_AGENT_TOKENS in the environment wins.
M1_AGENT_TOKENS=
