# Copy to agent/mcp/.env (ignored). Never paste credentials in chat.
MANDATE_CONTRACT_ID=
NEAR_RPC=https://rpc.testnet.near.org
AGENT_NEAR_PRIVATE_KEY=
AGENT_EVM_ADDRESS=
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Comma-separated seller origins controlled/approved by the operator. Loopback HTTP is allowed.
MCP_SELLER_ORIGINS=http://127.0.0.1:4021
# M1 service token for this agent, matching its entry in M1_AGENT_TOKENS. Not Monerium credentials.
M1_URL=http://127.0.0.1:8787/payouts
M1_AGENT_TOKEN=
# PP3 (rails/paypal) service and this agent's token, matching its entry in PP3_AGENT_TOKENS. Not PayPal credentials.
PP3_URL=http://127.0.0.1:8788/payouts
PP3_AGENT_TOKEN=
# Relative paths are resolved against agent/mcp (receipts) or scamcheck (held queue).
MCP_RECEIPT_DIR=.receipts
SCAMCHECK_HELD_DIR=
# Optional for x402/SEPA (absent key means explicitly skipped, per SC1). Required for pay_paypal: without it PayPal payments are blocked.
NEAR_AI_API_KEY=
# Or leave the key unset here: it is then read from this file (default ~/.config/nearh/nearai.env).
NEAR_AI_ENV_FILE=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=
