# Owner-side values (scripts/owner/). Copy to scripts/owner/.env (untracked).
# Names only: never commit a value. No private passkey material here or anywhere in the repo:
# owner calls are signed by the owner's passkey in the browser/authenticator.

# passkey or wallet (the fallback owner mode chosen at deploy)
OWNER_MODE=
# WebAuthn site the owner's passkey belongs to, and the origin checked by the contract
OWNER_RP_ID=
OWNER_ORIGIN=
# Wallet-mode owner account only
OWNER_NEAR_ACCOUNT_ID=

# --- Payee registry (owner calls add_payee; the demo reads it too) ---
# Allowlisted demo payee IBAN (Monerium sandbox only, never a real IBAN)
MONERIUM_PAYEE_IBAN=
